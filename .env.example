# Copie este arquivo para ".env" e preencha com as chaves do seu projeto Supabase.
# Você encontra esses valores no painel do Supabase em: Project Settings > API

# URL do projeto (ex: https://xxxxxxxx.supabase.co)
VITE_SUPABASE_URL=

# Chave pública (anon/publishable key)
VITE_SUPABASE_PUBLISHABLE_KEY=
